APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Match `php artisan serve` URL when using Vite dev (npm run dev); default proxy is :8000
# VITE_DEV_SERVER_PROXY=http://127.0.0.1:8001
# For iPhone/LAN testing with Vite: set to your Mac LAN IP (not 127.0.0.1)
# VITE_HMR_HOST=192.168.1.20

# MarketCheck Cars API — “New Vehicles in Market” uses ONLY live inventory when enabled below.
# https://www.marketcheck.com/apis/cars/
MARKETCHECK_ENABLED=false
MARKETCHECK_API_KEY=
# Set true only if you need API to return listings that already have photo URLs in the response
MARKETCHECK_INVENTORY_PHOTO_LINKS=false
MARKETCHECK_BASE_URL=https://api.marketcheck.com
MARKETCHECK_COUNTRY=us
# ZIP or latitude+longitude + radius (miles, max 100 on free tier) — improves local results
MARKETCHECK_ZIP=
# MARKETCHECK_LATITUDE=
# MARKETCHECK_LONGITUDE=
MARKETCHECK_RADIUS=100
MARKETCHECK_FEATURED_ROWS=20
MARKETCHECK_CACHE_TTL=21600
MARKETCHECK_CACHE_EMPTY_TTL=600
# Premium carousel: high minimum price, luxury makes, sort by price desc (requires MarketCheck enabled + API key)
MARKETCHECK_LUXURY_SHOWCASE=false
MARKETCHECK_LUXURY_PRICE_RANGE=125000-10000000
# MARKETCHECK_LUXURY_MAKES=Mercedes-Benz,BMW,Porsche,Ferrari,Lamborghini,Bentley,Rolls-Royce,Aston Martin,McLaren
# Tracked outbound links (hours) — /inventory/out/{token} then redirect to dealer VDP; no raw IP stored
MARKETCHECK_OUTBOUND_TOKEN_TTL=72
# Inventory search filters (GET /v2/search/car/active) — API uses price_range=min-max, not price_max
# MARKETCHECK_SEARCH_MAKE=Ferrari
# MARKETCHECK_SEARCH_MODEL=
# MARKETCHECK_PRICE_RANGE=0-500000
# Or cap only max price (sent as price_range=0-{MARKETCHECK_PRICE_MAX}):
# MARKETCHECK_PRICE_MAX=500000
# Optional: new | used | certified — leave empty for all types in search
# MARKETCHECK_CAROUSEL_CAR_TYPE=
# When MarketCheck is off: in APP_ENV=local this defaults to true (seeded demo cars on the home carousel).
# Set to false to force the empty state until MarketCheck is configured.
# MARKETCHECK_CAROUSEL_DATABASE_FALLBACK=false
