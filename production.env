# CarWise.ai - Production Environment Configuration
# Konfigurimi për lëshimin në internet

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME="CarWise.ai"
APP_ENV=production
APP_KEY=base64:CHANGE_THIS_TO_YOUR_APP_KEY
APP_DEBUG=false
APP_URL=https://carwise.ai
APP_TIMEZONE=Europe/Tirana

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carwise_production
DB_USERNAME=carwise_user
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# ===========================================
# CACHE & SESSION CONFIGURATION
# ===========================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=CHANGE_THIS_TO_REDIS_PASSWORD
REDIS_PORT=6379

# ===========================================
# MAIL CONFIGURATION
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=CHANGE_THIS_TO_MAIL_USERNAME
MAIL_PASSWORD=CHANGE_THIS_TO_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@carwise.ai
MAIL_FROM_NAME="CarWise.ai"

# ===========================================
# AI PROVIDERS CONFIGURATION
# ===========================================
DEFAULT_AI_PROVIDER=openai
AI_FALLBACK_ENABLED=true
MAX_AI_COST_PER_DIAGNOSIS=0.50

# OpenAI Configuration
OPENAI_API_KEY=CHANGE_THIS_TO_OPENAI_KEY
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# Claude Configuration
CLAUDE_API_KEY=CHANGE_THIS_TO_CLAUDE_KEY
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=2000
CLAUDE_TEMPERATURE=0.3

# Gemini Configuration
GEMINI_API_KEY=CHANGE_THIS_TO_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=2000
GEMINI_TEMPERATURE=0.3

# Cohere Configuration
COHERE_API_KEY=CHANGE_THIS_TO_COHERE_KEY
COHERE_MODEL=command-r
COHERE_MAX_TOKENS=2000
COHERE_TEMPERATURE=0.3

# Mistral Configuration
MISTRAL_API_KEY=CHANGE_THIS_TO_MISTRAL_KEY
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MAX_TOKENS=2000
MISTRAL_TEMPERATURE=0.3

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================
# BROADCASTING CONFIGURATION
# ===========================================
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ===========================================
# VITE CONFIGURATION
# ===========================================
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
BCRYPT_ROUNDS=12
JWT_SECRET=CHANGE_THIS_TO_JWT_SECRET

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_MINUTE=1000

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=128
OPCACHE_INTERNED_STRINGS_BUFFER=8
OPCACHE_MAX_ACCELERATED_FILES=4000
OPCACHE_REVALIDATE_FREQ=2
OPCACHE_FAST_SHUTDOWN=1

# ===========================================
# PUBLIC APIs INTEGRATION
# ===========================================
# NHTSA Vehicle API (Free - No API key required)
NHTSA_API_ENABLED=true

# eBay Motors API
EBAY_APP_ID=CHANGE_THIS_TO_EBAY_APP_ID
EBAY_CLIENT_SECRET=CHANGE_THIS_TO_EBAY_CLIENT_SECRET
EBAY_API_ENABLED=true

# Amazon Product Advertising API
AMAZON_ACCESS_KEY=CHANGE_THIS_TO_AMAZON_ACCESS_KEY
AMAZON_SECRET_KEY=CHANGE_THIS_TO_AMAZON_SECRET_KEY
AMAZON_PARTNER_TAG=CHANGE_THIS_TO_AMAZON_PARTNER_TAG
AMAZON_API_ENABLED=true

# TecDoc API (Commercial - requires subscription)
TECDOC_API_KEY=CHANGE_THIS_TO_TECDOC_API_KEY
TECDOC_API_URL=https://webservice.tecalliance.services
TECDOC_API_ENABLED=false

# CarMD API (Free tier available)
CARMED_API_KEY=CHANGE_THIS_TO_CARMED_API_KEY
CARMED_API_URL=https://api.carmd.com/v3.0
CARMED_API_ENABLED=false

# Autodoc API (B2B - requires partnership)
AUTODOC_API_KEY=CHANGE_THIS_TO_AUTODOC_API_KEY
AUTODOC_API_URL=https://api.autodoc.de
AUTODOC_API_ENABLED=false



